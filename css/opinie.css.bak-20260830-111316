
/* ==========================================================
   OPINIE
========================================================== */

.reviews-section {
  position: relative !important;
  width: 100% !important;
  padding: 86px 0 82px !important;
  overflow: hidden !important;

  background:
    linear-gradient(
      135deg,
      #132633 0%,
      #182733 55%,
      #10202b 100%
    ) !important;

  color: #ffffff !important;
}


/* szeroki kontener */
.reviews-section > .container {
  width: min(calc(100% - 76px), 1420px) !important;
  max-width: none !important;
  margin-left: auto !important;
  margin-right: auto !important;
}


/* ==========================================================
   GORA SEKCJI
========================================================== */

.reviews-top {
  display: grid !important;

  grid-template-columns:
    minmax(0, 1.25fr)
    minmax(350px, .75fr) !important;

  gap: 70px !important;

  align-items: end !important;
}


.reviews-intro {
  max-width: 760px !important;
}


.reviews-intro .section-label {
  display: block !important;

  margin: 0 0 16px !important;

  color: var(--yellow) !important;

  font-size: 11px !important;
  font-weight: 950 !important;

  text-transform: uppercase !important;

  letter-spacing: .12em !important;
}


.reviews-intro h2 {
  max-width: 760px !important;

  margin: 0 !important;

  color: #ffffff !important;

  font-size:
    clamp(42px, 4vw, 60px) !important;

  line-height: 1.02 !important;

  letter-spacing: -.045em !important;

  font-weight: 900 !important;
}


.reviews-intro > p {
  max-width: 690px !important;

  margin: 22px 0 0 !important;

  color: #c0cad0 !important;

  font-size: 15px !important;

  line-height: 1.68 !important;
}


.reviews-intro .reviews-transparency {
  margin-top: 11px !important;

  color: #8fa0aa !important;

  font-size: 12px !important;

  line-height: 1.55 !important;
}


/* ==========================================================
   GOOGLE MAPS
========================================================== */

.reviews-google-box {
  padding: 25px !important;

  border:
    1px solid rgba(255,255,255,.14) !important;

  border-radius: 16px !important;

  background:
    rgba(7,16,22,.38) !important;

  color: #ffffff !important;

  box-shadow:
    0 20px 45px rgba(0,0,0,.14) !important;
}


.reviews-google-kicker {
  display: block !important;

  margin-bottom: 10px !important;

  color: var(--yellow) !important;

  font-size: 10px !important;

  font-weight: 950 !important;

  letter-spacing: .13em !important;
}


.reviews-google-box > strong {
  display: block !important;

  color: #ffffff !important;

  font-size: 21px !important;

  line-height: 1.2 !important;
}


.reviews-google-box > p {
  margin: 10px 0 19px !important;

  color: #9eabb3 !important;

  font-size: 13px !important;

  line-height: 1.55 !important;
}


.reviews-google-button {
  width: 100% !important;

  min-height: 52px !important;

  padding: 10px 17px !important;

  display: flex !important;

  align-items: center !important;

  justify-content: space-between !important;

  gap: 20px !important;

  border-radius: 10px !important;

  background:
    var(--yellow) !important;

  color:
    var(--ink) !important;

  font-size: 12px !important;

  font-weight: 950 !important;

  text-decoration: none !important;

  transition:
    transform .18s ease,
    background .18s ease !important;
}


.reviews-google-button:hover {
  background: #ffd332 !important;

  transform:
    translateY(-1px) !important;
}


/* ==========================================================
   TYTUL NAD SCREENAMI
========================================================== */

.reviews-google {
  margin-top: 54px !important;

  padding-top: 31px !important;

  border-top:
    1px solid rgba(255,255,255,.11) !important;
}


.reviews-subheading {
  display: flex !important;

  justify-content: space-between !important;

  align-items: end !important;

  gap: 40px !important;
}


.reviews-mini-label {
  display: block !important;

  color: var(--yellow) !important;

  font-size: 10px !important;

  font-weight: 950 !important;

  letter-spacing: .12em !important;
}


.reviews-subheading h3 {
  margin: 6px 0 0 !important;

  color: #ffffff !important;

  font-size: 25px !important;

  line-height: 1.15 !important;

  letter-spacing: -.025em !important;
}


.reviews-subheading > p {
  max-width: 390px !important;

  margin: 0 !important;

  color: #84959f !important;

  font-size: 11px !important;

  line-height: 1.5 !important;

  text-align: right !important;
}


/* ==========================================================
   4 OPINIE OBOK SIEBIE
========================================================== */

.reviews-gallery {
  width: 100% !important;

  margin-top: 21px !important;

  display: grid !important;

  grid-template-columns:
    repeat(4, minmax(0, 1fr)) !important;

  gap: 14px !important;

  align-items: stretch !important;
}


.reviews-shot {
  position: relative !important;

  width: 100% !important;

  min-width: 0 !important;

  height: 350px !important;

  display: flex !important;

  align-items: center !important;

  justify-content: center !important;

  overflow: hidden !important;

  border:
    1px solid rgba(255,255,255,.12) !important;

  border-radius: 13px !important;

  background: #ffffff !important;

  box-shadow:
    0 12px 28px rgba(0,0,0,.13) !important;

  transition:
    transform .18s ease,
    border-color .18s ease !important;
}


.reviews-shot:hover {
  transform:
    translateY(-3px) !important;

  border-color:
    rgba(255,196,0,.72) !important;
}


.reviews-shot img {
  width: 100% !important;

  height: 100% !important;

  max-width: none !important;

  display: block !important;

  object-fit: contain !important;

  object-position: center !important;

  background: #ffffff !important;
}


/* ==========================================================
   PRZYSZLE WIDEO
========================================================== */

.reviews-video {
  margin-top: 55px !important;

  padding-top: 31px !important;

  border-top:
    1px solid rgba(255,255,255,.11) !important;
}


.reviews-video-heading {
  display: flex !important;

  align-items: end !important;

  justify-content: space-between !important;

  gap: 45px !important;
}


.reviews-video-heading h3 {
  margin: 6px 0 0 !important;

  color: #ffffff !important;

  font-size: 25px !important;

  line-height: 1.15 !important;

  letter-spacing: -.025em !important;
}


.reviews-video-heading > p {
  max-width: 500px !important;

  margin: 0 !important;

  color: #8798a2 !important;

  font-size: 12px !important;

  line-height: 1.55 !important;
}


.reviews-video-grid {
  margin-top: 21px !important;

  display: grid !important;

  grid-template-columns:
    repeat(3, minmax(0,1fr)) !important;

  gap: 14px !important;
}


.reviews-video-placeholder {
  min-height: 128px !important;

  padding: 22px !important;

  display: flex !important;

  align-items: center !important;

  gap: 18px !important;

  border:
    1px dashed rgba(255,255,255,.23) !important;

  border-radius: 13px !important;

  background:
    rgba(7,16,22,.18) !important;
}


.reviews-video-placeholder > span {
  width: 42px !important;

  height: 42px !important;

  flex: 0 0 42px !important;

  display: grid !important;

  place-items: center !important;

  border-radius: 50% !important;

  background:
    var(--yellow) !important;

  color:
    var(--ink) !important;

  font-size: 10px !important;

  font-weight: 950 !important;
}


.reviews-video-placeholder strong {
  display: block !important;

  color: #ffffff !important;

  font-size: 14px !important;

  line-height: 1.35 !important;
}


.reviews-video-placeholder small {
  display: block !important;

  margin-top: 5px !important;

  color: #82939e !important;

  font-size: 10px !important;

  line-height: 1.45 !important;
}


/* ==========================================================
   LAPTOP
========================================================== */

@media (max-width: 1250px) {

  .reviews-section > .container {
    width:
      calc(100% - 60px) !important;
  }


  .reviews-top {
    gap: 42px !important;
  }


  .reviews-gallery {
    grid-template-columns:
      repeat(2, minmax(0,1fr)) !important;
  }


  .reviews-shot {
    height: 410px !important;
  }

}


/* ==========================================================
   TABLET
========================================================== */

@media (max-width: 900px) {

  .reviews-section {
    padding:
      70px 0 !important;
  }


  .reviews-section > .container {
    width:
      calc(100% - 40px) !important;
  }


  .reviews-top {
    grid-template-columns:
      1fr !important;

    gap:
      30px !important;
  }


  .reviews-google-box {
    max-width:
      640px !important;
  }


  .reviews-subheading,
  .reviews-video-heading {
    display:
      grid !important;

    gap:
      10px !important;
  }


  .reviews-subheading > p {
    text-align:
      left !important;
  }


  .reviews-video-grid {
    grid-template-columns:
      1fr !important;
  }

}


/* ==========================================================
   TELEFON
========================================================== */

@media (max-width: 620px) {

  .reviews-section {
    padding:
      58px 0 !important;
  }


  .reviews-section > .container {
    width:
      calc(100% - 28px) !important;
  }


  .reviews-intro h2 {
    font-size:
      38px !important;
  }


  .reviews-gallery {
    display: grid !important;

    grid-template-columns:
      none !important;

    grid-auto-flow:
      column !important;

    grid-auto-columns:
      84vw !important;

    overflow-x:
      auto !important;

    gap:
      12px !important;

    padding-bottom:
      12px !important;

    scroll-snap-type:
      x mandatory !important;

    scrollbar-width:
      thin !important;
  }


  .reviews-shot {
    height:
      390px !important;

    scroll-snap-align:
      start !important;
  }


  .reviews-google,
  .reviews-video {
    margin-top:
      42px !important;
  }

}